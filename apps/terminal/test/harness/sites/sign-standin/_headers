# STAND-IN for SIGN_HOST until card signpage-skeleton lands packages/signpage/public/_headers; then hosts.mjs serves
# the signing page's own build and this dir is deleted. Minimal on purpose: a passkey may be made here, the page may be
# framed only by the harness's APP_HOST, and nothing else loads.
/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; connect-src 'self'; frame-ancestors https://app.ct.test; object-src 'none'; base-uri 'none'; form-action 'none'
  Permissions-Policy: publickey-credentials-create=(self), publickey-credentials-get=(self)
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff

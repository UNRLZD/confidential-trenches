{
  "name": "terminal",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test build/*.test.mjs scripts/check-deploy.test.ts test/*.test.ts test/harness/*.test.mjs",
    "harness": "vite build && node test/harness/selftest.mjs",
    "test:e2e": "node test/return-hop/run.mjs"
  },
  "dependencies": {
    "@blindfill/kit": "workspace:*",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "playwright": "1.63.0",
    "typescript": "6.0.3",
    "vite": "8.3.5"
  }
}

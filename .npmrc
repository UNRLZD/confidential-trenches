# Card readme-run-fits-an-agent-timeout: `pnpm -r run <script>` starts every package's script at once (up to
# workspace-concurrency), not in dependency order. Sorted, it ran three rounds one after another (the kit alone, then
# five packages, then the signing page alone on three of a runner's four cores) and the README's test line took 13 min.
# No script needs a dependency's script first: every workspace package exports its src/ files, none builds on install.
sort=false

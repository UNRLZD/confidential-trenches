{
  "name": "@blindfill/wallet",
  "private": true,
  "type": "module",
  "exports": {
    "./derive": {
      "types": "./src/derive/index.ts",
      "default": "./src/derive/index.ts"
    },
    "./store": {
      "types": "./src/store/index.ts",
      "default": "./src/store/index.ts"
    },
    "./signin/passkey": {
      "types": "./src/signin/passkey.ts",
      "default": "./src/signin/passkey.ts"
    },
    "./signin/words": {
      "types": "./src/signin/words.ts",
      "default": "./src/signin/words.ts"
    },
    "./arming/records": {
      "types": "./src/arming/records.ts",
      "default": "./src/arming/records.ts"
    },
    "./arming/ladder": {
      "types": "./src/arming/ladder.ts",
      "default": "./src/arming/ladder.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --test \"test/*.test.ts\"",
    "test:mutants": "FULL_RUNS=1 node --test test/note-restore.test.ts test/store.test.ts test/note-store-crash.test.ts test/pool-solana.test.ts && node scripts/note-restore-refund-mutants.mjs && node scripts/near-prepay-taken-mutants.mjs && node scripts/held-moveout-mutants.mjs 1/2 && node scripts/held-moveout-mutants.mjs 2/2 && node scripts/refund-move-mutants.mjs && node scripts/exit-scan-mutants.mjs && node scripts/restore-wallets-mutants.mjs",
    "test:e2e": "node test/store.e2e.mjs && node test/passkey.e2e.mjs",
    "typecheck": "tsc -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "@blindfill/kit": "workspace:*",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@scure/base": "2.4.0",
    "@scure/bip32": "2.4.0",
    "@scure/bip39": "2.4.0",
    "poseidon-lite": "0.3.0"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "fake-indexeddb": "6.2.6",
    "playwright": "1.63.0"
  }
}

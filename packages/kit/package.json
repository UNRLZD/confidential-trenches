{
  "name": "@blindfill/kit",
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && node -e \"import('@blindfill/kit').then(m => { if (!m.SIGNPAGE_KINDS || !m.ZK_SETUP_FILES) process.exit(1) })\" && node --test \"test/*.test.mjs\" \"test/*.test.ts\" \"test/prover/*.test.mjs\"",
    "test:e2e": "node test/prover/chromium.e2e.mjs"
  },
  "exports": {
    ".": { "types": "./src/index.ts", "default": "./src/index.ts" },
    "./core": { "types": "./src/core.ts", "default": "./src/core.ts" },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@scure/base": "2.4.0",
    "snarkjs": "0.7.5"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "playwright": "1.63.0",
    "rolldown": "1.2.15"
  }
}
